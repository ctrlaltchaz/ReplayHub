}

model Incident {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  eventId       String?  @map("event_id")
  category      String
  severity      String
  title         String
  description   String?
  ownerId       String?  @map("owner_id")
  status        String   @default("open")
  tags          String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  rcaJson       Json?    @map("rca_json")
  createdByUser OrgUser  @relation("IncidentCreator", fields: [createdBy], references: [id])
  event         Event?   @relation(fields: [eventId], references: [id])
  owner         OrgUser? @relation("IncidentOwner", fields: [ownerId], references: [id])

  @@index([tenantId, category, severity, status, createdAt])
  @@map("incidents")
}

model Attendance {
  id             String                   @id @default(cuid())
  tenantId       String                   @map("tenant_id")
  eventId        String                   @map("event_id")
  orgUserId      String                   @map("org_user_id")
  role           String?
  status         String                   @default("pending")
  note           String?
  createdBy      String                   @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  department     AttendanceDepartment?
  roleNotes      String?                  @map("role_notes")
  absenceReason  AttendanceAbsenceReason? @map("absence_reason")
  absenceNotes   String?                  @map("absence_notes")
  clockInAt      DateTime?                @map("clock_in_at")
  clockOutAt     DateTime?                @map("clock_out_at")
  autoClockOut   Boolean                  @default(false) @map("auto_clock_out")
  lateFlag       Boolean                  @default(false) @map("late_flag")
  source         AttendanceSource         @default(student)
  overrideReason String?                  @map("override_reason")
  reviewedBy     String?                  @map("reviewed_by")
  reviewedAt     DateTime?                @map("reviewed_at")
  scheduledDate  DateTime?                @map("scheduled_date")
  sessionId      String?                  @map("session_id")
  createdByUser  OrgUser                  @relation("AttendanceCreator", fields: [createdBy], references: [id])
  event          Event                    @relation(fields: [eventId], references: [id])
  orgUser        OrgUser                  @relation("AttendanceUser", fields: [orgUserId], references: [id])
  reviewedByUser OrgUser?                 @relation("AttendanceReviewer", fields: [reviewedBy], references: [id])
  session        ProductionSession?       @relation(fields: [sessionId], references: [id])

  @@unique([tenantId, eventId, orgUserId])
  @@index([tenantId, eventId])
  @@index([tenantId, sessionId])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, status])
  @@map("attendance")
}

model ProductionSession {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
