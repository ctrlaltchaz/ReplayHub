# ============================================================================
# SECURE PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# This configuration uses a non-superuser database role for RLS enforcement

# Database Configuration - PRODUCTION SECURE SETUP
DATABASE_USER=esports_app
DATABASE_PASSWORD=esports_app_secure_2024!
DATABASE_NAME=esports_ops
DATABASE_PORT=5432

# Redis Configuration  
REDIS_PASSWORD=esports_ops_redis_2024!
REDIS_PORT=6379

# MinIO Object Storage Configuration
MINIO_ROOT_USER=esports-admin
MINIO_ROOT_PASSWORD=esports_minio_2024!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Environment
NODE_ENV=production

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-in-production-min-32-chars

# Application URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# BACKEND APPLICATION ENVIRONMENT VARIABLES
# ============================================================================

# Database URL with secure role - CRITICAL FOR RLS ENFORCEMENT
DATABASE_URL=postgresql://esports_app:esports_app_secure_2024!@localhost:5432/esports_ops?schema=public

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_PATH=/app/uploads

# TOTP Configuration
TOTP_ISSUER=Esports Ops Platform
TOTP_WINDOW=1

# RLS Configuration
RLS_ENABLED=true
TENANT_ISOLATION_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_RLS_QUERIES=false  # Set to true for debugging RLS issues