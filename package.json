{
  "name": "esports-operations-platform",
  "version": "0.3.2 (beta) Last update: 05-12-2025",
  "description": "Multi-tenant esports operations platform monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "ui:build": "npm run build --workspace=packages/ui",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "npm run migration:run --workspace=apps/api",
    "db:migrate:revert": "npm run migration:revert --workspace=apps/api",
    "db:migrate:show": "npm run migration:show --workspace=apps/api",
    "db:create": "npm run migration:create --workspace=apps/api --",
    "seed:tenant-perms": "cd apps/api && npx ts-node -r tsconfig-paths/register scripts/seed-tenant-permissions.ts",
    "seed:permissions": "cd apps/api && npx ts-node -r tsconfig-paths/register scripts/seed-all-permissions.ts",
    "mobile": "cd apps/mobile && npx expo start"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@nestjs/cli": "^11.0.14",
    "@types/json2csv": "^5.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-preset-expo": "^54.0.7",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "typescript": "^5.1.3"
  },
  "packageManager": "npm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "json2csv": "^6.0.0-alpha.2",
    "postcss-value-parser": "^4.2.0"
  }
}