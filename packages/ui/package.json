{
  "name": "@esports-ops/ui",
  "version": "1.0.0",
  "description": "Shared UI components for esports operations platform",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo \"lint not configured\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "echo \"No UI tests configured\""
  },
  "devDependencies": {
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}