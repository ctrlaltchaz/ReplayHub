# ============================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================================================

# Database Configuration - PRODUCTION SECURE (uses non-superuser role for RLS)
DATABASE_USER=esports_app
DATABASE_PASSWORD=esports_app_secure_2024!
DATABASE_NAME=esports_ops
DATABASE_PORT=5432

# Redis Configuration  
REDIS_PASSWORD=esports_ops_redis_2024!
REDIS_PORT=6379

# MinIO Object Storage Configuration
MINIO_ROOT_USER=esports-admin
MINIO_ROOT_PASSWORD=esports_minio_2024!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this-in-production-min-32-chars

# Application URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# BACKEND APPLICATION ENVIRONMENT VARIABLES
# ============================================================================

# Database URL - CRITICAL FOR RLS ENFORCEMENT (uses secure non-superuser role)
DATABASE_URL=postgresql://esports_app:esports_app_secure_2024!@localhost:5432/esports_ops?schema=public

# Row-Level Security Configuration
RLS_ENABLED=true
TENANT_ISOLATION_ENABLED=true

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_PATH=/app/uploads

# TOTP Configuration
TOTP_ISSUER=Esports Ops Platform
TOTP_WINDOW=1

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Discord Bot Configuration (Optional - for Discord integration)
# Get these from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord Encryption Key (32-character random string for encrypting bot tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DISCORD_ENCRYPTION_KEY=190f333a27aad08c05b9ebcbb40b03bed009767ef5d223d7298ee712a037be0c

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email Settings
EMAIL_FROM=noreply@replayhub.com
EMAIL_FROM_NAME=ReplayHub

# ============================================================================
# FRONTEND APPLICATION ENVIRONMENT VARIABLES  
# ============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME=Esports Operations Platform
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_ORGANIZATION_CREATION=true