model Event {
  id                         String                 @id @default(cuid())
  tenantId                   String                 @map("tenant_id")
  title                      String
  startAt                    DateTime               @map("start_at")
  endAt                      DateTime               @map("end_at")
  location                   String?
  teamId                     String?                @map("team_id")
  lineupId                   String?                @map("lineup_id")
  notes                      String?
  status                     String                 @default("scheduled")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  broadcastChannel           String?                @map("broadcast_channel")
  callTime                   DateTime?              @map("call_time")
  checklistId                String?                @map("checklist_id")
  duration                   Int?
  eventType                  String                 @default("Other") @map("event_type")
  gameTitle                  String?                @map("game_title")
  graphicsPackage            String?                @map("graphics_package")
  rosterId                   String?                @map("roster_id")
  bestOf                     Int?                   @default(1) @map("best_of")
  opponent                   String?
  tournamentName             String?                @map("tournament_name")
  tournamentStage            String?                @map("tournament_stage")
  createdByGlobalUserId      String?                @map("created_by_global_user_id")
  productionLeadGlobalUserId String?                @map("production_lead_global_user_id")
  attendance                 Attendance[]
  bookings                   Booking[]
  createdByGlobalUser        GlobalUser?            @relation("EventCreator", fields: [createdByGlobalUserId], references: [id])
  lineup                     Lineup?                @relation(fields: [lineupId], references: [id])
  productionLeadGlobalUser   GlobalUser?            @relation("EventProductionLead", fields: [productionLeadGlobalUserId], references: [id])
  team                       Team?                  @relation(fields: [teamId], references: [id])
  incidents                  Incident[]
  productionSessions         ProductionSession[]
  runsheets                  Runsheet[]
  staffAssignments           EventStaffAssignment[]

  @@index([tenantId, startAt, endAt])
  @@index([tenantId, eventType])
  @@index([tenantId, gameTitle])
  @@map("events")
}

model EventStaffAssignment {
  id        String   @id @default(cuid())
