generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GlobalUser {
  id                      String                       @id @default(cuid())
  email                   String                       @unique
  passwordHash            String                       @map("password_hash")
  totpSecret              String?                      @map("totp_secret")
  isTotpEnabled           Boolean                      @default(false) @map("is_totp_enabled")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  isActive                Boolean                      @default(true) @map("is_active")
  isGlobalAdmin           Boolean                      @default(false) @map("is_global_admin")
  lastLoginAt             DateTime?                    @map("last_login_at")
  name                    String?
  avatar                  String?
  bio                     String?
  location                String?
  socialLinks             Json?                        @map("social_links")
  timezone                String?
  pendingEmail            String?                      @map("pending_email")
  emailVerificationCode   String?                      @map("email_verification_code")
  emailVerificationExpiry DateTime?                    @map("email_verification_expiry")
  auditLogs               AuditLog[]
  eventsCreated           Event[]                      @relation("EventCreator")
  eventsProduced          Event[]                      @relation("EventProductionLead")
  feedbackComments        FeedbackComment[]
  feedbackSubmissions     FeedbackSubmission[]
  inventoryMovements      InventoryMovement[]          @relation("MovementsByUser")
  matchesCreated          Match[]                      @relation("MatchCreator")
  orgUsers                OrgUser[]                    @relation("OrgUserToGlobalUser")
  organisationAdmins      OrganisationAdmin[]
  organisations           Organisation[]
  playerStats             PlayerStat[]                 @relation("PlayerStatUser")
  players                 Player[]                     @relation("PlayerUser")
  teamsCoached            Team[]                       @relation("TeamCoach")
  discordLinks            UserDiscordLink?             @relation("UserDiscordLinks")
  memberships             UserOrganisationMembership[]

  @@map("global_users")
}

model Organisation {
  id                 String                       @id @default(cuid())
  name               String
  slug               String                       @unique
  branding           Json?                        @default("{}")
  features           Json?                        @default("{}")
  ownerId            String                       @map("owner_id")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  quickLinksJson     Json?                        @default("[]") @map("quick_links_json")
  auditLogs          AuditLog[]                   @relation("TenantAuditLogs")
  invites            OrgInvite[]
  orgUsers           OrgUser[]                    @relation("OrgUserToOrganisation")
  admins             OrganisationAdmin[]
  owner              GlobalUser                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productionSessions ProductionSession[]          @relation("OrganisationSessions")
  memberships        UserOrganisationMembership[]
  liveGraphics       LiveGraphic[]

  @@map("organisations")
}

model OrganisationAdmin {
  id             String       @id @default(cuid())
  organisationId String       @map("organisation_id")
  globalUserId   String       @map("global_user_id")
  role           String       @default("owner")
  createdAt      DateTime     @default(now()) @map("created_at")
  globalUser     GlobalUser   @relation(fields: [globalUserId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, globalUserId])
  @@map("organisation_admins")
}

model Note {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  title     String
  body      String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("notes")
}

model OrgUser {
  id                  String                 @id @default(cuid())
  tenantId            String                 @map("tenant_id")
  email               String
  passwordHash        String                 @map("password_hash")
  displayName         String                 @map("display_name")
  isActive            Boolean                @default(true) @map("is_active")
  totpSecret          String?                @map("totp_secret")
  isTotpEnabled       Boolean                @default(false) @map("is_totp_enabled")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  globalUserId        String?                @map("global_user_id")
  createdAttendance   Attendance[]           @relation("AttendanceCreator")
  attendanceRecords   Attendance[]           @relation("AttendanceUser")
  reviewedAttendance  Attendance[]           @relation("AttendanceReviewer")
  auditLogs           AuditLog[]
  createdIncidents    Incident[]             @relation("IncidentCreator")
  ownedIncidents      Incident[]             @relation("IncidentOwner")
  roles               OrgUserRole[]
  globalUser          GlobalUser?            @relation("OrgUserToGlobalUser", fields: [globalUserId], references: [id])
  organisation        Organisation           @relation("OrgUserToOrganisation", fields: [tenantId], references: [id], onDelete: Cascade)
  createdSessions     ProductionSession[]    @relation("SessionCreator")
  staffAssignments    EventStaffAssignment[]
  createdLiveGraphics LiveGraphic[]          @relation("LiveGraphicCreatedBy")
  updatedLiveGraphics LiveGraphic[]          @relation("LiveGraphicUpdatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("org_users")
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  name            String
  desc            String?          @map("description")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  membershipRoles MembershipRole[]
  orgUserRoles    OrgUserRole[]
  permissions     RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  key       String
  group     String?
  desc      String?          @map("description")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  roles     RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

model OrgUserRole {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  orgUserId String   @map("org_user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  orgUser   OrgUser  @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orgUserId, roleId])
  @@index([tenantId, orgUserId])
  @@map("org_user_roles")
}

model UserOrganisationMembership {
  id                     String             @id @default(cuid())
  tenantId               String             @map("tenant_id")
  userId                 String             @map("user_id")
  email                  String
  displayName            String?            @map("display_name")
  isActive               Boolean            @default(true) @map("is_active")
  isTotpEnabled          Boolean            @default(false) @map("is_totp_enabled")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  roles                  MembershipRole[]
  organisation           Organisation       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   GlobalUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordEntriesCreated PasswordEntry[]    @relation("PasswordCreatedByMembership")
  passwordEntriesUpdated PasswordEntry[]    @relation("PasswordUpdatedByMembership")
  passwordAuditLogs      PasswordAuditLog[]

  @@unique([userId, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@map("user_org_memberships")
}

model MembershipRole {
  id           String                     @id @default(cuid())
  tenantId     String                     @map("tenant_id")
  membershipId String                     @map("membership_id")
  roleId       String                     @map("role_id")
  createdAt    DateTime                   @default(now()) @map("created_at")
  membership   UserOrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
  @@map("membership_roles")
}

model OrgInvite {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  email        String?
  invitedById  String       @map("invited_by_id")
  rolesJson    Json         @default("[]") @map("roles_json")
  tokenHash    String       @map("token_hash")
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  inviteMethod InviteMethod @default(EMAIL) @map("invite_method")
  token        String       @unique
  acceptedById String?      @map("accepted_by_id")
  organisation Organisation @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tokenHash])
  @@index([token])
  @@map("org_invites")
}

model AuditLog {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  entityType   AuditEntityType? @map("entity_type")
  entityId     String?          @map("entity_id")
  userId       String?          @map("user_id")
  orgUserId    String?          @map("org_user_id")
  ipAddress    String?          @map("ip_address")
  userAgent    String?          @map("user_agent")
  createdAt    DateTime         @default(now()) @map("created_at")
  description  String?
  endpoint     String?
  entity       String?
  errorMessage String?          @map("error_message")
  metadata     Json?
  method       String?
  status       String           @default("success")
  action       String
  orgUser      OrgUser?         @relation(fields: [orgUserId], references: [id])
  organisation Organisation     @relation("TenantAuditLogs", fields: [tenantId], references: [id], onDelete: Cascade)
  user         GlobalUser?      @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, createdAt])
  @@index([tenantId, entityType, createdAt])
  @@index([tenantId, orgUserId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Team {
  id                String        @id @default(cuid())
  tenantId          String        @map("tenant_id")
  name              String
  game              String
  season            String?
  status            String        @default("active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  captainId         String?       @map("captain_id")
  coachGlobalUserId String?       @map("coach_global_user_id")
  achievements      Achievement[]
  events            Event[]
  lineups           Lineup[]
  matches           Match[]
  members           TeamMember[]
  captain           Player?       @relation("TeamCaptain", fields: [captainId], references: [id])
  coachGlobalUser   GlobalUser?   @relation("TeamCoach", fields: [coachGlobalUserId], references: [id])

  @@unique([tenantId, name, season])
  @@index([tenantId])
  @@map("teams")
}

model Player {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  gamerTag     String         @map("gamer_tag")
  role         String?
  rank         String?
  mainsJson    Json?          @default("[]") @map("mains_json")
  bio          String?
  socialsJson  Json?          @default("{}") @map("socials_json")
  eligibility  String?
  consentJson  Json?          @default("{}") @map("consent_json")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  realName     String?        @map("real_name")
  avatar       String?
  statsVisible Boolean        @default(true) @map("stats_visible")
  globalUserId String?        @map("global_user_id")
  achievements Achievement[]
  availability Availability[]
  lineupSlots  LineupSlot[]
  playerStats  PlayerStat[]
  globalUser   GlobalUser?    @relation("PlayerUser", fields: [globalUserId], references: [id])
  teams        TeamMember[]
  captainOf    Team[]         @relation("TeamCaptain")

  @@unique([tenantId, gamerTag])
  @@index([tenantId])
  @@map("players")
}

model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  teamId    String   @map("team_id")
  playerId  String   @map("player_id")
  isStarter Boolean  @default(false) @map("is_starter")
  position  String?
  createdAt DateTime @default(now()) @map("created_at")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teamId, playerId])
  @@index([tenantId, teamId])
  @@map("team_members")
}

model Availability {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  playerId  String   @map("player_id")
  date      DateTime
  status    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, playerId, date])
  @@index([tenantId, date])
  @@map("availability")
}

model Lineup {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  eventId     String       @map("event_id")
  teamId      String       @map("team_id")
  title       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  published   Boolean      @default(false)
  events      Event[]
  slots       LineupSlot[]
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches     Match[]
  playerStats PlayerStat[]

  @@unique([tenantId, eventId])
  @@index([tenantId, teamId])
  @@map("lineups")
}

model LineupSlot {
  id       String  @id @default(cuid())
  tenantId String  @map("tenant_id")
  lineupId String  @map("lineup_id")
  playerId String  @map("player_id")
  role     String?
  isSub    Boolean @default(false) @map("is_sub")
  notes    String?
  idx      Int     @default(0)
  lineup   Lineup  @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, lineupId, playerId])
  @@index([tenantId, lineupId])
  @@map("lineup_slots")
}

model Achievement {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  teamId    String?  @map("team_id")
  playerId  String?  @map("player_id")
  title     String
  eventRef  String?  @map("event_ref")
  date      DateTime
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("achievements")
}

model Runsheet {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  eventId   String?        @map("event_id")
  title     String
  status    String         @default("draft")
  revision  Int            @default(1)
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  items     RunsheetItem[]
  event     Event?         @relation(fields: [eventId], references: [id])

  @@index([tenantId])
  @@index([tenantId, eventId])
  @@map("runsheets")
}

model RunsheetItem {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  runsheetId      String   @map("runsheet_id")
  idx             Int
  title           String
  ownerId         String?  @map("owner_id")
  durationMs      Int      @default(0) @map("duration_ms")
  notes           String?
  attachmentsJson Json?    @default("[]") @map("attachments_json")
  createdAt       DateTime @default(now()) @map("created_at")
  type            String?
  location        String?
  equipment       String?
  priority        String?  @default("normal")
  runsheet        Runsheet @relation(fields: [runsheetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, runsheetId, idx])
  @@index([tenantId, runsheetId])
  @@map("runsheet_items")
}

model RunsheetTemplate {
  id          String                 @id @default(cuid())
  tenantId    String                 @map("tenant_id")
  name        String
  description String?
  createdBy   String                 @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  items       RunsheetTemplateItem[]

  @@index([tenantId])
  @@map("runsheet_templates")
}

model RunsheetTemplateItem {
  id         String           @id @default(cuid())
  templateId String           @map("template_id")
  idx        Int
  title      String
  type       String?
  ownerId    String?          @map("owner_id")
  durationMs Int              @default(0) @map("duration_ms")
  location   String?
  equipment  String?
  priority   String?          @default("normal")
  notes      String?
  template   RunsheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("runsheet_template_items")
}

model ChecklistTemplate {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  title      String
  scope      String
  version    Int         @default(1)
  itemsJson  Json        @map("items_json")
  createdBy  String      @map("created_by")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  checklists Checklist[]

  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("checklist_templates")
}

model Checklist {
  id             String             @id @default(cuid())
  tenantId       String             @map("tenant_id")
  templateId     String?            @map("template_id")
  scopeRef       String?            @map("scope_ref")
  dueAt          DateTime?          @map("due_at")
  assigneeId     String?            @map("assignee_id")
  status         String             @default("pending")
  createdAt      DateTime           @default(now()) @map("created_at")
  completedItems Json               @default("[]") @map("completed_items")
  itemsJson      Json?              @map("items_json")
  scope          String?
  title          String?
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  runs           ChecklistRun[]
  template       ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@map("checklists")
}

model ChecklistRun {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  checklistId String    @map("checklist_id")
  runnerId    String    @map("runner_id")
  runAt       DateTime  @default(now()) @map("run_at")
  resultJson  Json      @map("result_json")
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([tenantId, checklistId])
  @@index([tenantId, runnerId])
  @@index([tenantId, checklistId, runAt])
  @@map("checklist_runs")
}

model InventoryItem {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  tag       String
  name      String
  type      String
  serial    String?
  condition String              @default("good")
  location  String?
  status    String              @default("available")
  notes     String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  kitItems  InventoryKitItem[]
  movements InventoryMovement[]

  @@unique([tenantId, tag])
  @@index([tenantId, type, status])
  @@map("inventory_items")
}

model InventoryKit {
  id        String             @id @default(cuid())
  tenantId  String             @map("tenant_id")
  name      String
  createdAt DateTime           @default(now()) @map("created_at")
  items     InventoryKitItem[]

  @@unique([tenantId, name])
  @@map("inventory_kits")
}

model InventoryKitItem {
  id       String        @id @default(cuid())
  tenantId String        @map("tenant_id")
  kitId    String        @map("kit_id")
  itemId   String        @map("item_id")
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kit      InventoryKit  @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kitId, itemId])
  @@map("inventory_kit_items")
}

model InventoryMovement {
  id       String        @id @default(cuid())
  tenantId String        @map("tenant_id")
  itemId   String        @map("item_id")
  fromLoc  String?       @map("from_loc")
  toLoc    String?       @map("to_loc")
  byUserId String?       @map("by_user_id")
  at       DateTime      @default(now())
  note     String?
  byUser   GlobalUser?   @relation("MovementsByUser", fields: [byUserId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId, at])
  @@map("inventory_movements")
}

model Asset {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  path      String
  name      String
  mime      String
  size      Int
  version   Int            @default(1)
  status    String         @default("active")
  tags      String?
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  versions  AssetVersion[]

  @@index([tenantId, status])
  @@map("assets")
}

model AssetVersion {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  assetId   String   @map("asset_id")
  path      String
  size      Int
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId])
  @@map("asset_versions")
}

model Match {
  id                    String       @id @default(cuid())
  tenantId              String       @map("tenant_id")
  eventId               String?      @map("event_id")
  teamId                String       @map("team_id")
  lineupId              String?      @map("lineup_id")
  opponent              String
  tournament            String?
  stage                 String?
  bestOf                Int          @default(1)
  startedAt             DateTime?
  endedAt               DateTime?
  status                String       @default("draft")
  result                String?
  score                 String?
  vodUrl                String?      @map("vod_url")
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdByGlobalUserId String?      @map("created_by_global_user_id")
  maps                  MapGame[]
  createdByGlobalUser   GlobalUser?  @relation("MatchCreator", fields: [createdByGlobalUserId], references: [id])
  lineup                Lineup?      @relation(fields: [lineupId], references: [id])
  team                  Team         @relation(fields: [teamId], references: [id])
  playerStats           PlayerStat[]

  @@index([tenantId, teamId, startedAt])
  @@map("matches")
}

model MapGame {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  matchId     String       @map("match_id")
  title       String
  mapName     String?
  gameIdx     Int
  ourScore    Int          @default(0) @map("our_score")
