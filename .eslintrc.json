{
    "root": true,
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "ignorePatterns": [
        "node_modules/",
        "dist/",
        ".next/",
        "build/",
        "**/*.d.ts"
    ],
    "overrides": [
        {
            "files": [
                "**/*.{ts,tsx}"
            ],
            "parser": "@typescript-eslint/parser",
            "parserOptions": {
                "ecmaVersion": "latest",
                "sourceType": "module",
                "ecmaFeatures": {
                    "jsx": true
                }
            },
            "plugins": [
                "@typescript-eslint"
            ],
            "extends": [
                "eslint:recommended"
            ],
            "rules": {
                "no-unused-vars": "off",
                "no-undef": "off"
            }
        },
        {
            "files": [
                "apps/web/**/*.{ts,tsx,js,jsx}"
            ],
            "env": {
                "browser": true,
                "es2021": true
            },
            "extends": [
                "eslint:recommended",
                "next/core-web-vitals"
            ]
        },
        {
            "files": [
                "**/*.{js,jsx}"
            ],
            "env": {
                "browser": true,
                "es2021": true,
                "node": true
            },
            "extends": [
                "eslint:recommended"
            ],
            "parserOptions": {
                "ecmaVersion": "latest",
                "sourceType": "module",
                "ecmaFeatures": {
                    "jsx": true
                }
            }
        }
    ]
}